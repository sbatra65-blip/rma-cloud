@* Select-or-add master picker. Value is the selected Id (0 = none). *@
@inject MasterDataService Masters
@inject UserSessionService Session

<div class="master-picker">
    <div class="master-picker-row">
        <select class="form-control" value="@Value" @onchange="OnSelect" disabled="@Disabled">
            <option value="0">@Placeholder</option>
            @foreach (var o in _options)
            {
                <option value="@o.Id">@o.Label</option>
            }
        </select>
        @if (_canAdd && !Disabled)
        {
            <button class="btn btn-ghost btn-sm" type="button" title="Add new" @onclick="OpenAdd">+</button>
        }
    </div>
</div>

@if (_showAdd)
{
    <div class="modal-backdrop" @onclick="CloseAdd">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="card-title">Add @_kindLabel</div>
            @if (!string.IsNullOrEmpty(_addError))
            {
                <div class="error-msg">@_addError</div>
            }
            <div class="form-group">
                <label>Code (optional)</label>
                <input class="form-control" @bind="_addCode" />
            </div>
            <div class="form-group">
                <label>Name</label>
                <input class="form-control" @bind="_addName" />
            </div>
            @if (Kind == "carepacktype")
            {
                <div class="form-group">
                    <label>Duration years</label>
                    <input class="form-control" type="number" min="1" max="10" @bind="_addYears" />
                </div>
            }
            @if (Kind == "customer")
            {
                <div class="form-group">
                    <label>City (manual)</label>
                    <input class="form-control" @bind="_addCity" />
                </div>
                <div class="form-group">
                    <label>State (manual)</label>
                    <input class="form-control" @bind="_addState" />
                </div>
            }
            @if (Kind == "product" && ParentId is null or <= 0)
            {
                <div class="error-msg">Select an OEM first.</div>
            }
            @if (Kind == "model" && ParentId is null or <= 0)
            {
                <div class="error-msg">Select a Product first.</div>
            }
            <div class="form-actions" style="justify-content:flex-end;margin-top:12px">
                <button class="btn btn-ghost" type="button" @onclick="CloseAdd">Cancel</button>
                <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="SaveAdd">Save</button>
            </div>
        </div>
    </div>
}

@code {
    public record Option(int Id, string Label);

    [Parameter] public string Kind { get; set; } = "customer"; // oem|product|model|customer|carepacktype
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public EventCallback<Option?> SelectedChanged { get; set; }
    [Parameter] public int? ParentId { get; set; } // OEM for product, Product for model
    [Parameter] public string Placeholder { get; set; } = "— Select —";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowAdd { get; set; } = true;

    List<Option> _options = [];
    bool _canAdd, _showAdd, _busy;
    string _kindLabel = "item";
    string _addCode = "", _addName = "", _addCity = "", _addState = "", _addError = "";
    int _addYears = 5;

    protected override async Task OnParametersSetAsync()
    {
        _kindLabel = Kind switch
        {
            "oem" => "OEM / Vendor",
            "product" => "Product",
            "model" => "Model",
            "customer" => "Customer",
            "carepacktype" => "Care Pack Type",
            _ => "item"
        };
        var (_, role) = await Session.GetCurrentAsync();
        _canAdd = AllowAdd && AppRoles.CanManageMasters(role);
        await Reload();
    }

    async Task Reload()
    {
        try
        {
            _options = Kind switch
            {
                "oem" => (await Masters.ListOemsAsync()).Select(o => new Option(o.Id, o.Name)).ToList(),
                // Cascade: product/model lists stay empty until parent OEM/Product is chosen
                "product" => ParentId is > 0
                    ? (await Masters.ListProductsAsync(ParentId)).Select(p => new Option(p.Id, p.Name)).ToList()
                    : [],
                "model" => ParentId is > 0
                    ? (await Masters.ListModelsAsync(ParentId)).Select(m => new Option(m.Id, $"{m.Code} — {m.Name}")).ToList()
                    : [],
                "customer" => (await Masters.ListCustomersAsync()).Select(c => new Option(c.Id, c.Name)).ToList(),
                "carepacktype" => (await Masters.ListCarePackTypesAsync()).Select(t => new Option(t.Id, t.Name)).ToList(),
                _ => []
            };
        }
        catch
        {
            _options = [];
        }
    }

    async Task OnSelect(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) id = 0;
        await ValueChanged.InvokeAsync(id);
        var opt = _options.FirstOrDefault(o => o.Id == id);
        await SelectedChanged.InvokeAsync(opt);
    }

    void OpenAdd()
    {
        _addError = "";
        _addCode = _addName = _addCity = _addState = "";
        _addYears = 5;
        _showAdd = true;
    }

    void CloseAdd() => _showAdd = false;

    async Task SaveAdd()
    {
        _busy = true;
        _addError = "";
        try
        {
            int newId;
            string label;
            switch (Kind)
            {
                case "oem":
                    var oem = await Masters.CreateOemAsync(_addCode, _addName);
                    newId = oem.Id; label = oem.Name;
                    break;
                case "product":
                    if (ParentId is null or <= 0) throw new InvalidOperationException("Select an OEM first.");
                    var prod = await Masters.CreateProductAsync(ParentId.Value, _addCode, _addName);
                    newId = prod.Id; label = prod.Name;
                    break;
                case "model":
                    if (ParentId is null or <= 0) throw new InvalidOperationException("Select a Product first.");
                    var model = await Masters.CreateModelAsync(ParentId.Value, _addCode, _addName);
                    newId = model.Id; label = $"{model.Code} — {model.Name}";
                    break;
                case "customer":
                    var cust = await Masters.CreateCustomerAsync(_addCode, _addName, _addCity, _addState);
                    newId = cust.Id; label = cust.Name;
                    break;
                case "carepacktype":
                    var cp = await Masters.CreateCarePackTypeAsync(_addName, _addYears);
                    newId = cp.Id; label = cp.Name;
                    break;
                default:
                    throw new InvalidOperationException("Unknown master kind.");
            }

            await Reload();
            _showAdd = false;
            await ValueChanged.InvokeAsync(newId);
            await SelectedChanged.InvokeAsync(new Option(newId, label));
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
