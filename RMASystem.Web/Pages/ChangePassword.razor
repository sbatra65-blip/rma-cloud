@page "/change-password"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Change Password — RMA System</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <div class="login-brand">RMA System</div>
        <h1 class="login-title">Update password</h1>
        <p class="help-text">
            Your password is expired or must be changed before you can use the app.
        </p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }

        <form method="post" action="/api/auth/change-password">
            <div class="form-group">
                <label>Current password</label>
                <input class="form-control" type="password" name="currentPassword" required />
            </div>
            <div class="form-group">
                <label>New password (min 8 characters)</label>
                <input class="form-control" type="password" name="newPassword" required minlength="8" />
            </div>
            <div class="form-group">
                <label>Confirm new password</label>
                <input class="form-control" type="password" name="confirmPassword" required minlength="8" />
            </div>
            <button class="btn btn-primary" type="submit" style="width:100%;margin-top:12px">
                Save new password
            </button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    string? _error;
    protected override void OnInitialized() => _error = Error;
}
