@page "/admin/sessions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject AuthService Auth
@inject UserSessionService Session
@inject NavigationManager Nav

<PageTitle>Sessions — RMA System</PageTitle>

<div class="page-hero care-hero">
    <div>
        <h1 class="page-hero-title">Active user sessions</h1>
        <p class="page-hero-sub">End a running session to force sign-out on the next request (or within ~30s).</p>
    </div>
    <div class="page-hero-actions">
        <a href="/admin/users" class="btn btn-ghost">Users</a>
        <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="Reload">Refresh</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error)) { <div class="error-msg">@_error</div> }
@if (!string.IsNullOrEmpty(_ok)) { <div class="success-msg">@_ok</div> }

<div class="card">
    <div class="tbl-wrap">
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Started</th>
                    <th>Last seen</th>
                    <th>IP</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_sessions.Count == 0)
                {
                    <tr><td colspan="6" class="empty-cell">No active sessions.</td></tr>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        <tr>
                            <td>
                                <strong>@s.User.DisplayName</strong>
                                <div class="muted"><code>@s.User.UserName</code></div>
                            </td>
                            <td>@s.User.Role</td>
                            <td>@s.StartedAt.ToString("dd-MMM HH:mm")</td>
                            <td>@s.LastSeenAt.ToString("dd-MMM HH:mm:ss")</td>
                            <td>@(s.IpAddress ?? "—")</td>
                            <td>
                                <button class="btn btn-danger btn-sm" type="button" disabled="@_busy"
                                        @onclick="@(() => End(s.Id))">End session</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    List<AppUserSession> _sessions = new();
    int _adminUserId;
    string? _error, _ok;
    bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureSettingsAsync();
        if (!await Session.IsAdminAsync())
        {
            Nav.NavigateTo("/");
            return;
        }
        var uid = Session.GetUserId();
        if (uid is null or <= 0)
        {
            Nav.NavigateTo("/login", true);
            return;
        }
        _adminUserId = uid.Value;
        await Reload();
    }

    async Task Reload()
    {
        _busy = true; _error = null;
        try { _sessions = await Auth.ListActiveSessionsAsync(_adminUserId); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    async Task End(Guid id)
    {
        _busy = true; _error = _ok = null;
        try
        {
            await Auth.RevokeSessionAsync(_adminUserId, id);
            _ok = "Session ended.";
            await Reload();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
