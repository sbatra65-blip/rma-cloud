{
  // TrackMyRMA — one Worker serves the PWA (static assets) and the /api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rma-cloud",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    // The Worker sees every request so it can send /console to the console site (or to its own domain).
    "run_worker_first": true
  },

  // The OEM RMA Excel form ships inside the Worker as the default template.
  "rules": [{ "type": "Data", "globs": ["**/*.xlsx"], "fallthrough": false }],

  // Directory = logins, 2FA, sessions, companies and who belongs to which company (one instance).
  // Company   = one private SQLite database per company (tickets, photos, masters, batches).
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "COMPANY", "class_name": "Company" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory", "Company"] }
  ],

  // Optional: uncomment after creating an R2 bucket named "rma-photos".
  // Without it, photos are stored inside each company's own database.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "rma-photos" }],

  // Daily RMA reminder email at 09:00 IST (03:30 UTC).
  "triggers": { "crons": ["30 3 * * *"] },

  "vars": {
    "APP_NAME": "TrackMyRMA",
    "IDLE_MINUTES": "15",
    "MAX_SESSION_HOURS": "12",
    "PBKDF2_ITERATIONS": "100000",
    "CONSOLE_IDLE_MINUTES": "15"
    // Optional (set in the Cloudflare dashboard; keep_vars stops deploys wiping them):
    //   MAIL_FROM     e.g. "TrackMyRMA <noreply@trackmyrma.com>" — sender on your
    //                 Resend-verified domain. Without it, mail goes from Resend's test sender.
    //   RESEND_API_KEY (secret) — from resend.com, needed for any email
    //   CONSOLE_HOST  e.g. "console.trackmyrma.com" — console only on that domain
    //   APP_URL       e.g. "https://trackmyrma.com" — the main address: email links point here, and
    //                 pages opened on any other domain attached to this Worker (old address,
    //                 .in / .co.in, www) are redirected here. /api keeps working on every domain.
    //   CONSOLE_SETUP_KEY (secret) — needed once to create the first console operator
  },

  "keep_vars": true,
  "observability": { "enabled": true }
}
